{
  "id": "com.smartq.calendarViz.visualizationDatamodelHandler",
  "version": "1.0.0",
  "module": "com-smartq-calendarviz/calendarVizdatamodelhandler",
  "method": "getHandler",
  "config": {
    "vizPreference": 50,

    "measureLabelConfig": {
      "supportedEdges": ["color", "glyph", "size", "tooltip"],
      "defaultEdge": "row",
      "visibility": "hidden"
    },

    "edgeConfig": {
      "row": {
        "contentType": "categorical",
        "global": {
          "priority": 1,
          "minCount": 3,
          "maxCount": 5,
          "preferredMax": 5
        },
        "ui": {
          "customName": {
            "key": "CALENDARVIZ_ROW",
            "default": "Rows"
          },
          "description": "1st: Task title, 2nd: subtitle/ID, 3rd: date (used for calendar placement), 4th: middle text, 5th: bottom text"
        },
        "categorical": {
          "functionalInfo": ["categoricalType"]
        }
      },
      "color": {
        "contentType": "categorical",
        "global": {
          "priority": 3,
          "minCount": 0,
          "maxCount": 1
        },
        "ui": {
          "customName": {
            "key": "CALENDARVIZ_COLOR",
            "default": "Color Category"
          },
          "description": "Category for color-coding tasks"
        },
        "categorical": {
          "functionalInfo": ["inner", "row", "categoricalType"]
        }
      },
      "glyph": {
        "contentType": "categorical",
        "global": {
          "priority": 5,
          "minCount": 0,
          "maxCount": 2,
          "preferredMax": 2
        },
        "ui": {
          "customName": {
            "key": "CALENDARVIZ_CONDITIONAL_FORMATTING",
            "default": "Conditional Formatting"
          },
          "_forceCustomName": true,
          "description": "1st column = RED condition flag, 2nd column = YELLOW condition flag."
        },
        "categorical": {
          "functionalInfo": ["categoricalType"]
        }
      },
      "size": {
        "contentType": "categorical",
        "global": {
          "priority": 6,
          "minCount": 0,
          "maxCount": 1,
          "preferredMax": 1
        },
        "ui": {
          "customName": {
            "key": "CALENDARVIZ_URL",
            "default": "URL"
          },
          "_forceCustomName": true,
          "description": "Optional hyperlink target opened when the task title is clicked."
        },
        "categorical": {
          "functionalInfo": ["categoricalType"]
        }
      },
      "tooltip": {
        "contentType": "categorical",
        "global": {
          "priority": 7,
          "minCount": 0,
          "maxCount": 5
        },
        "ui": {
          "customName": {
            "key": "CALENDARVIZ_TOOLTIP",
            "default": "Additional Info"
          },
          "description": "Additional information to show in task tooltips"
        },
        "categorical": {
          "functionalInfo": ["categoricalType"]
        }
      },
      "measures": {
        "contentType": "measures",
        "global": {
          "minCount": 0,
          "maxCount": 1,
          "priority": 10
        },
        "ui": {
          "customName": {
            "key": "CALENDARVIZ_MEASURES",
            "default": "Measures"
          },
          "description": "Optional numeric values"
        }
      },
      "detail": "none"
    }
  }
}
