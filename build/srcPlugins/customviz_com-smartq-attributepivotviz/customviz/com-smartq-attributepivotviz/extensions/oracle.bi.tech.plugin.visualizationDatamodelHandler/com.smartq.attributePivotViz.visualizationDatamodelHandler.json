{
  "id": "com.smartq.attributePivotViz.visualizationDatamodelHandler",
  "version": "1.0.1",
  "module": "com-smartq-attributepivotviz/attributePivotVizdatamodelhandler",
  "method": "getHandler",
  "config": {
    "vizPreference": 50,

    "measureLabelConfig": {
      "supportedEdges": ["row", "size", "glyph", "color", "detail", "tooltip"],
      "defaultEdge": "row",
      "visibility": "hidden"
    },

    "edgeConfig": {

      "row": {
        "contentType": "categorical",
        "global": {
          "priority": 1,
          "minCount": 1,
          "maxCount": 8,
          "preferredMax": 2
        },
        "ui": {
          "customName": {
            "default": ""
          },
          "order": 1,
          "description": "Dimensions that define the row headers of the pivot table (1–8 columns)"
        },
        "categorical": {
          "functionalInfo": ["categoricalType"]
        }
      },

      "size": {
        "contentType": "categorical",
        "global": {
          "priority": 2,
          "minCount": 1,
          "maxCount": 8,
          "preferredMax": 1
        },
        "ui": {
          "customName": {
            "key": "ATTRIBUTEPIVOTVIZ_COLUMNS",
            "default": "Columns"
          },
          "_forceCustomName": true,
          "order": 2,
          "description": "Dimensions that define the column headers of the pivot table (1–8 columns)"
        },
        "categorical": {
          "functionalInfo": ["categoricalType"]
        }
      },

      "glyph": {
        "contentType": "categorical",
        "global": {
          "priority": 3,
          "minCount": 0,
          "maxCount": 1,
          "preferredMax": 1
        },
        "ui": {
          "customName": {
            "key": "ATTRIBUTEPIVOTVIZ_TEXT_VALUES",
            "default": "Value (Attribute)"
          },
          "_forceCustomName": true,
          "order": 4,
          "description": "Attribute value to display in cell intersections (1 column). Multiple distinct values at the same row/column combination expand the intersection into multiple sub-rows."
        },
        "categorical": {
          "functionalInfo": ["categoricalType"]
        }
      },

      "color": {
        "contentType": "categorical",
        "global": {
          "priority": 4,
          "minCount": 0,
          "maxCount": 1,
          "preferredMax": 1
        },
        "ui": {
          "customName": {
            "key": "ATTRIBUTEPIVOTVIZ_COLOR_ATTR",
            "default": "Color (Attributes)"
          },
          "_forceCustomName": true,
          "order": 6,
          "description": "Optional attribute used to color cell accents."
        },
        "categorical": {
          "functionalInfo": ["inner", "row", "categoricalType"]
        }
      },

      "detail": {
        "contentType": "measures",
        "global": {
          "priority": 5,
          "minCount": 0,
          "maxCount": 1,
          "preferredMax": 1
        },
        "ui": {
          "customName": {
            "key": "ATTRIBUTEPIVOTVIZ_COLOR_METRIC",
            "default": "Color (Metric)"
          },
          "_forceCustomName": true,
          "order": 5,
          "description": "Optional measure used to color measure values."
        }
      },

      "tooltip": {
        "contentType": "categorical",
        "global": {
          "priority": 6,
          "minCount": 0,
          "maxCount": 5,
          "preferredMax": 2
        },
        "ui": {
          "customName": {
            "default": ""
          },
          "order": 7,
          "description": "Optional extra attributes shown in tooltips."
        },
        "categorical": {
          "functionalInfo": ["categoricalType"]
        }
      },

      "measures": {
        "contentType": "measures",
        "global": {
          "priority": 7,
          "minCount": 0,
          "maxCount": 1,
          "preferredMax": 1
        },
        "ui": {
          "customName": {
            "key": "ATTRIBUTEPIVOTVIZ_MEASURE",
            "default": "Value (Measure)"
          },
          "_forceCustomName": true,
          "order": 3,
          "description": "Optional numeric measure to display in cell intersections."
        }
      }
    }
  }
}
